{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist/server"
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts"]
}
