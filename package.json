{
  "name": "openai-auth-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && tsup src/server/index.ts src/server/cli.ts --format esm --out-dir dist/server --sourcemap",
    "start": "node dist/server/index.js",
    "hash-password": "tsx src/server/cli.ts hash-password",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.1",
    "lucide-vue-next": "^0.468.0",
    "otplib": "^12.0.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "playwright-core": "^1.55.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.8"
  }
}
